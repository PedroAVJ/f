# V's Mac app entry for a UI module: the web app's step (an address goes to
# its page, every other input to update) and loop, but it starts from s()
# without waiting for an address and shows f(s) as Canvas commands, which
# the native shell paints (UI.show_canvas, request 4)
import V
import ../../bend2/std/F/deployment/domain/architecture/system/deploy/ops.bend as Verbs

def main() -> IO(Unit):
  IO.write(Verbs.native_entry("ui"))
